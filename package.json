{
  "name": "mentorconnect",
  "version": "1.0.0",
  "description": "Production-Ready Mentor–Mentee Management System for Educational Institutions",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prompt:record": "node scripts/record-prompt.js",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify-db.ts"
  },
  "keywords": [
    "mentor",
    "mentee",
    "education",
    "management-system",
    "react",
    "express",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "author": "MentorConnect Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  }
}
