# ==========================================
# MentorConnect Environment Configuration
# ==========================================

# Database Configurations:
# ------------------------------------------
# 1. Local Development PostgreSQL:
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/mentorconnect?schema=public"
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/mentorconnect?schema=public"

# 2. Neon Free PostgreSQL (Serverless Cloud Database):
# Pooled Connection URL (for runtime queries in serverless/hosted environments):
# DATABASE_URL="postgresql://[user]:[password]@[ep-xyz]-pooler.[region].aws.neon.tech/neondb?sslmode=require"
# Direct Connection URL (for Prisma CLI schema migrations):
# DIRECT_URL="postgresql://[user]:[password]@[ep-xyz].[region].aws.neon.tech/neondb?sslmode=require"

# Test Database URL:
TEST_DATABASE_URL="postgresql://postgres:your_password@localhost:5432/mentorconnect_test?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets (Must be changed to strong random secrets in production)
JWT_ACCESS_SECRET="your-256-bit-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRATION="1h"
JWT_REFRESH_EXPIRATION="7d"

# Client CORS & Frontend Configuration
# In Render: Set to your Netlify URL e.g. "https://your-site.netlify.app"
CORS_ORIGIN="http://localhost:5173"

# In Netlify: Set to your Render Backend URL e.g. "https://your-api.onrender.com/api/v1"
VITE_API_URL="http://localhost:5000/api/v1"
