# ==========================================
# MentorConnect Environment Configuration
# ==========================================

# Database Configurations
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/mentorconnect?schema=public"

# Supabase PostgreSQL (Cloud):
# Host: db.tdoxexppqdzqhynmuyzh.supabase.co | Port: 5432 | User: postgres | DB: postgres
DATABASE_URL="postgresql://postgres:[YOUR-SUPABASE-PASSWORD]@db.tdoxexppqdzqhynmuyzh.supabase.co:5432/postgres?sslmode=require"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/mentorconnect_test?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your-256-bit-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRATION="1h"
JWT_REFRESH_EXPIRATION="7d"

# Client CORS & Frontend Configuration
CORS_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:5000/api/v1"
